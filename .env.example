# Copia del JSON de cuenta de servicio descargado desde Firebase:
# project_id
FIREBASE_PROJECT_ID=bitacorabct
# Valores de la app web de Firebase (no son secretos):
FIREBASE_API_KEY=
FIREBASE_APP_ID=
# Opcional; por defecto se usa <project-id>.firebaseapp.com:
FIREBASE_AUTH_DOMAIN=
# Correos autorizados, separados por comas:
FIREBASE_ALLOWED_EMAILS=
# client_email
FIREBASE_CLIENT_EMAIL=
# private_key: pega su contenido entre comillas dobles y conserva los \n.
FIREBASE_PRIVATE_KEY=""
