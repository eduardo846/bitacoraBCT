# Configuración pública de Firebase Web, expuesta por Vite al navegador:
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Opcionales para otros servicios de Firebase:
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Configuración privada para Firebase Admin en el servidor:
FIREBASE_PROJECT_ID=bitacorabct
FIREBASE_CLIENT_EMAIL=
# Pega private_key entre comillas dobles y conserva los \n.
FIREBASE_PRIVATE_KEY=""
# Correos autorizados por el backend, separados por comas:
FIREBASE_ALLOWED_EMAILS=
